# CMake build tree, including the generated PiPL .rr/.rrc/.rc intermediates
build/

# Visual Studio / Xcode local state
.vs/
*.user
*.suo
xcuserdata/
*.xcworkspace

# Build output
*.aex
*.plugin
*.obj
*.pdb
*.ilk
*.exp
*.lib

# ...except the ready-to-download build in dist/, which is committed on purpose
# so people who do not build from source can grab it straight from the repo.
!dist/*.aex
!dist/*.plugin

# The After Effects SDK is never vendored here. It is located through
# AE_SDK_PATH. See README.md.
